# Variables de la API (apps/api) y de las migraciones/seed (packages/db).
# Copia este archivo a `.env` en la raíz del repo. Nunca subas `.env` (el repo es público).

# --- Base de datos (docker compose de desarrollo publica Postgres en 5499) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5499/gestor_ventas
DB_POOL_MAX=10
# Solo para los tests (pnpm --filter @gestor/api test); se crea sola si no existe.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5499/gestor_ventas_test

# --- API ---
NODE_ENV=development
PORT=4070
# En producción: 32+ caracteres aleatorios (openssl rand -base64 48). La API no arranca si es débil.
JWT_SECRET=change-me-in-development-0123456789
# Orígenes del panel permitidos por CORS (separados por coma). El primero se usa en los enlaces que devuelve MCP.
WEB_ORIGIN=http://127.0.0.1:5239,http://localhost:5239
# URL pública de la API: issuer OAuth y "resource" del servidor MCP (PUBLIC_URL/mcp).
# Si todo se sirve tras el panel (rewrites de Next o nginx), pon aquí la URL del panel.
# En Railway se infiere de RAILWAY_PUBLIC_DOMAIN si no se define.
PUBLIC_URL=http://127.0.0.1:4070
# Hosts extra aceptados en /mcp (protección DNS rebinding), separados por coma.
MCP_ALLOWED_HOSTS=
# Saltos de proxy de confianza (X-Forwarded-For) para la IP real en los rate limits.
TRUST_PROXY=1
LOG_LEVEL=debug

# --- Cookie de sesión del panel ---
# lax si panel y API comparten dominio (o el panel usa su proxy /api); none + https si están en dominios distintos.
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true   # por defecto: true en producción o con SameSite=none

# --- Tienda ---
STORE_NAME=Tienda Demo Lima
STORE_TIMEZONE=America/Lima
STORE_CURRENCY=PEN
# Impuesto que se suma a (subtotal − descuento) si la venta no envía `tax`. 0 = precios con impuesto incluido.
STORE_TAX_RATE=0
STORE_TAX_NAME=IGV

# --- Límites ---
RATE_LIMIT_ENABLED=true
LOGIN_MAX_FAILED_PER_15M=10
OAUTH_REGISTER_MAX_PER_HOUR=20
MCP_MAX_REQUESTS_PER_MIN=240
MCP_SESSION_TTL_MINUTES=30
MCP_MAX_SESSIONS_PER_USER=10
MCP_AUDIT_RETENTION_DAYS=90

# --- Seed (pnpm db:seed) ---
SEED_ADMIN_EMAIL=admin@ventas.com
SEED_SELLER_EMAIL=vendedor@ventas.com
# En desarrollo, si se omiten, la contraseña demo es admin123. En producción son obligatorias.
SEED_ADMIN_PASSWORD=
SEED_SELLER_PASSWORD=

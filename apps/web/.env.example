# Copia a apps/web/.env.local (Next.js no lee el .env de la raíz).

# URL interna de la API. El navegador llama a /api/* del propio panel y Next lo reenvía
# aquí (misma origen: la cookie de sesión funciona en cualquier dominio).
# También se usa en los rewrites de /mcp, /oauth y /.well-known: en producción se
# fija en tiempo de BUILD (ver apps/web/Dockerfile).
API_INTERNAL_URL=http://127.0.0.1:4070

# Opcional: llamar a la API directamente desde el navegador (requiere CORS y, si es otro
# dominio, COOKIE_SAMESITE=none en la API). Vacío = usar el proxy /api del panel.
NEXT_PUBLIC_API_URL=

# Muestra las credenciales demo en el login. NUNCA en producción real.
NEXT_PUBLIC_DEMO_MODE=true

# Formato de moneda del panel (debe coincidir con STORE_CURRENCY de la API).
NEXT_PUBLIC_CURRENCY=PEN
NEXT_PUBLIC_LOCALE=es-PE

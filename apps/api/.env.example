# La API lee primero el `.env` de la RAÍZ del repo (ver ../../.env.example, que tiene
# todas las variables documentadas) y después este archivo, si existe, para
# sobrescribir valores solo en apps/api. Mínimo necesario:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5499/gestor_ventas
JWT_SECRET=change-me-in-development-0123456789
PORT=4070
PUBLIC_URL=http://127.0.0.1:4070
WEB_ORIGIN=http://127.0.0.1:5239,http://localhost:5239
STORE_TIMEZONE=America/Lima

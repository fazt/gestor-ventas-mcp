# Para docker-compose.prod.yml:
#   cp .env.prod.example .env.prod && docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

WEB_PORT=8139
# URL pública del panel (MCP queda en PUBLIC_URL/mcp). Con un proxy HTTPS delante: https://ventas.tudominio.com
PUBLIC_URL=http://localhost:8139

POSTGRES_USER=gestor
POSTGRES_PASSWORD=cambia-esta-clave-larga
POSTGRES_DB=gestor_ventas

# openssl rand -base64 48
JWT_SECRET=cambia-esto-por-48-bytes-aleatorios-en-base64-xxxxxxxxxxxx

# true detrás de HTTPS (recomendado). false solo para probar en http://localhost.
COOKIE_SECURE=false
# Saltos de proxy: panel Next (1) + proxy HTTPS delante (1).
TRUST_PROXY=2
LOG_LEVEL=info

STORE_NAME=Mi tienda
STORE_TIMEZONE=America/Lima
STORE_CURRENCY=PEN
STORE_TAX_RATE=0
STORE_TAX_NAME=IGV

# Datos de demo en el primer arranque (idempotente). Exige contraseñas de 8+ caracteres.
SEED_ON_START=false
SEED_ADMIN_EMAIL=admin@ventas.com
SEED_ADMIN_PASSWORD=
SEED_SELLER_EMAIL=vendedor@ventas.com
SEED_SELLER_PASSWORD=

# Mostrar credenciales demo en el login (solo para demos públicas).
NEXT_PUBLIC_DEMO_MODE=false
